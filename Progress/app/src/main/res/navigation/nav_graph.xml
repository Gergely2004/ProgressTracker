<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools" android:id="@+id/nav_graph"
            app:startDestination="@id/registerFragment">
    <fragment android:id="@+id/homeFragment" android:name="com.example.progress.ui.home.HomeFragment"
              android:label="fragment_home" tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_homeFragment_to_profileFragment" app:destination="@id/profileFragment"/>
        <action android:id="@+id/action_homeFragment_to_addHabitFragment" app:destination="@id/addHabitFragment"/>
        <action android:id="@+id/action_homeFragment_to_createScheduleFragment" app:destination="@id/createScheduleFragment"/>
        <action android:id="@+id/action_homeFragment_to_createScheduleFragment2"
                app:destination="@id/createScheduleFragment"/>
        <action android:id="@+id/action_homeFragment_to_scheduleDetailsFragment" app:destination="@id/scheduleDetailsFragment" />
        <action android:id="@+id/action_homeFragment_to_loginFragment" app:destination="@id/loginFragment"
                app:popUpTo="@id/nav_graph"
                app:popUpToInclusive="true"
                app:launchSingleTop="true"/>
    </fragment>
    <fragment android:id="@+id/loginFragment" android:name="com.example.progress.ui.auth.LoginFragment"
              android:label="fragment_login" tools:layout="@layout/fragment_login">
        <action android:id="@+id/action_loginFragment_to_homeFragment" app:destination="@id/homeFragment"/>
    </fragment>
    <fragment android:id="@+id/profileFragment" android:name="com.example.progress.ui.profile.ProfileFragment"
              android:label="fragment_profile" tools:layout="@layout/fragment_profile">
        <action android:id="@+id/action_profileFragment_to_homeFragment" app:destination="@id/homeFragment"/>
        <action android:id="@+id/action_profileFragment_to_addHabitFragment" app:destination="@id/addHabitFragment"/>
        <action android:id="@+id/action_profileFragment_to_editProfileFragment" app:destination="@id/editProfileFragment"/>
        <action android:id="@+id/action_profileFragment_to_loginFragment" app:destination="@id/loginFragment"
                app:popUpTo="@id/nav_graph"
                app:popUpToInclusive="true"
                app:launchSingleTop="true"/>
    </fragment>
    <fragment android:id="@+id/addHabitFragment" android:name="com.example.progress.ui.habit.AddHabitFragment"
              android:label="fragment_add_habit" tools:layout="@layout/fragment_add_habit"/>
    <fragment android:id="@+id/registerFragment" android:name="com.example.progress.ui.auth.RegisterFragment"
              android:label="fragment_register" tools:layout="@layout/fragment_register">
        <action android:id="@+id/action_registerFragment_to_loginFragment" app:destination="@id/loginFragment"/>
    </fragment>
    <fragment android:id="@+id/createScheduleFragment" android:name="com.example.progress.ui.schedule.CreateScheduleFragment"
              android:label="fragment_create_schedule" tools:layout="@layout/fragment_create_schedule"/>
    <fragment android:id="@+id/addProgressFragment" android:name="com.example.progress.ui.progress.AddProgressFragment"
              android:label="fragment_add_progress" tools:layout="@layout/fragment_add_progress">
    </fragment>
    <fragment android:id="@+id/scheduleDetailsFragment" android:name="com.example.progress.ui.schedule.ScheduleDetailsFragment"
        android:label="fragment_schedule_details" tools:layout="@layout/fragment_schedule_details">
        <action android:id="@+id/action_scheduleDetailsFragment_to_editScheduleFragment" app:destination="@id/editScheduleFragment" />
    </fragment>
    <fragment android:id="@+id/editScheduleFragment" android:name="com.example.progress.ui.schedule.EditScheduleFragment"
        android:label="fragment_edit_schedule" tools:layout="@layout/fragment_edit_schedule">
    </fragment>
    <fragment android:id="@+id/editProfileFragment" android:name="com.example.progress.ui.profile.EditProfileFragment"
        android:label="fragment_edit_profile" tools:layout="@layout/fragment_edit_profile">
    </fragment>
</navigation>