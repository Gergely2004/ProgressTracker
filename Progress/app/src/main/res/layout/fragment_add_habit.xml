<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.progress.ui.habit.AddHabitFragment">

    <EditText
            android:id="@+id/editTextName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Name"
            android:inputType="textPersonName"
            android:autofillHints="name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="100dp" app:layout_constraintHorizontal_bias="0.0"/>
    <EditText
            android:id="@+id/editTextCategoryId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Category ID"
            android:inputType="number"
            android:autofillHints="none"
            app:layout_constraintTop_toBottomOf="@id/editTextDescription"
            app:layout_constraintStart_toStartOf="@id/editTextName"
            app:layout_constraintEnd_toEndOf="@id/editTextName"
            android:layout_marginTop="8dp" app:layout_constraintHorizontal_bias="0.0"/>
    <EditText
            android:id="@+id/editTextGoal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Goal"
            android:inputType="text"
            android:autofillHints="none"
            app:layout_constraintTop_toBottomOf="@id/editTextCategoryId"
            app:layout_constraintStart_toStartOf="@id/editTextName"
            app:layout_constraintEnd_toEndOf="@id/editTextName"
            android:layout_marginTop="4dp" app:layout_constraintHorizontal_bias="0.0"/>
    <Button
            android:id="@+id/btnCreateHabit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Habit"
            app:layout_constraintTop_toBottomOf="@+id/editTextGoal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    <EditText
            android:id="@+id/editTextDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:inputType="text"
            android:autofillHints="none"
            app:layout_constraintTop_toBottomOf="@id/editTextName"
            app:layout_constraintStart_toStartOf="@id/editTextName"
            app:layout_constraintEnd_toEndOf="@id/editTextName"
            android:layout_marginTop="8dp" app:layout_constraintHorizontal_bias="0.0"/>

</androidx.constraintlayout.widget.ConstraintLayout>
